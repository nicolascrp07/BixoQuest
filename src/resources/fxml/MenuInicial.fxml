<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<Pane prefHeight="600.0" prefWidth="800.0" stylesheets="@../css/geral.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.view.controller.MenuInicialController">
   <children>
      <ImageView fitHeight="600.0" fitWidth="800.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../imagens/TELAINICIAL.jpeg" />
         </image>
      </ImageView>
      <VBox layoutX="544.0" layoutY="165.0" prefHeight="199.0" prefWidth="242.0">
         <children>
            <Button contentDisplay="CENTER" mnemonicParsing="false" onAction="#botaoIniciarClicado" styleClass="botao-estilizado" text="INICIAR" textFill="#692424">
               <graphic>
                  <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../imagens/BOTAO.png" />
                     </image>
                  </ImageView>
               </graphic>
               <font>
                  <Font name="Verdana Bold" size="26.0" />
               </font>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
            <Button contentDisplay="CENTER" layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#botaoCarregarClicado" styleClass="botao-estilizado" text="CARREGAR" textFill="#692424">
               <graphic>
                  <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../imagens/BOTAO.png" />
                     </image>
                  </ImageView>
               </graphic>
               <font>
                  <Font name="Verdana Bold" size="23.0" />
               </font>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
         </children>
      </VBox>
   </children>
</Pane>
