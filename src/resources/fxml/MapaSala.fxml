<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.layout.VBox?>
<Pane prefHeight="600.0" prefWidth="800.0" stylesheets="@../css/geral.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.view.controller.SalaController">
   <children>
      <ImageView fx:id="imagemDeFundo" fitHeight="600.0" fitWidth="800.0" pickOnBounds="true" preserveRatio="true" />
      <fx:include fx:id="meuHud" layoutX="-80.0" layoutY="440.0" scaleX="0.7" scaleY="0.7" source="HUD.fxml" />
      <Button layoutX="660.0" layoutY="467.0" mnemonicParsing="false" onAction="#botaoSairDaSalaClicado" scaleX="0.5" scaleY="0.5" styleClass="botao-estilizado-pequeno">
         <graphic>
            <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../imagens/BOTAORETORNO.png" />
               </image>
            </ImageView>
         </graphic>
      </Button>
      <Button fx:id="btnAssistirAula" contentDisplay="CENTER" layoutX="14.0" layoutY="14.0" mnemonicParsing="false" onAction="#botaoAssistirAulaClicado" styleClass="botao-estilizado" text="ASSISTIR AULA" textFill="#692525">
         <graphic>
            <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" styleClass="botao-estilizado">
               <image>
                  <Image url="@../imagens/BOTAO.png" />
               </image>
            </ImageView>
         </graphic>
         <font>
            <Font name="Verdana Bold" size="12.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <VBox layoutX="580.0" layoutY="14.0" prefWidth="210.0" spacing="12.0">
         <children>
            <Label fx:id="labelNomeLocal" wrapText="true" text="Label" styleClass="texto-retro, texto-pixel-outline" style="-fx-font-size: 16px;" />
            <Label fx:id="labelDisciplina" wrapText="true" text="Label" styleClass="texto-retro, texto-pixel-outline" style="-fx-font-size: 14px;" />
            <Label fx:id="labelProfessor" wrapText="true" text="Label" styleClass="texto-retro, texto-pixel-outline" style="-fx-font-size: 14px;" />
         </children>
      </VBox>
      <fx:include fx:id="botaoNpcComponente" layoutX="70.0" layoutY="120.0" scaleX="0.8" scaleY="0.8" source="BotaoNPC.fxml" />
   </children>
</Pane>