<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.SepiaTone?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<Pane prefHeight="600.0" prefWidth="800.0" stylesheets="@../css/geral.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.view.controller.MenuIniciarJogoController">
   <children>
      <ImageView fitHeight="600.0" fitWidth="800.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../imagens/TELAINICIAL.jpeg" />
         </image>
      </ImageView>
      <ImageView fitHeight="588.0" fitWidth="728.0" layoutX="36.0" layoutY="27.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../imagens/MENUINICIARJOGO.jpeg" />
         </image>
      </ImageView>
      <ImageView fitHeight="239.0" fitWidth="118.0" layoutX="470.0" layoutY="145.0" pickOnBounds="true" preserveRatio="true" styleClass="botao-estilizado">
         <image>
            <Image url="@../imagens/PERSONAGEMFEMININA.png" />
         </image>
      </ImageView>
      <ImageView fitHeight="239.0" fitWidth="124.0" layoutX="228.0" layoutY="144.0" pickOnBounds="true" preserveRatio="true" styleClass="botao-estilizado">
         <image>
            <Image url="@../imagens/PERSONAGEMMASCULINO.png" />
         </image>
      </ImageView>
      <TextField fx:id="campoNome" layoutX="272.0" layoutY="426.0" prefHeight="40.0" prefWidth="255.0" promptText="DIGITE O SEU NOME:">
         <font>
            <Font name="Verdana Bold" size="12.0" />
         </font>
         <cursor>
            <Cursor fx:constant="TEXT" />
         </cursor>
         <effect>
            <SepiaTone level="0.21" />
         </effect>
      </TextField>
      <Button layoutX="295.0" layoutY="498.0" mnemonicParsing="false" onAction="#botaoComecarClicado" opacity="0.0" prefHeight="53.0" prefWidth="210.0">
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <Button layoutX="158.0" layoutY="126.0" mnemonicParsing="false" onAction="#selecionarAvatarBixo" opacity="0.0" prefHeight="275.0" prefWidth="216.0">
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <Button layoutX="421.0" layoutY="126.0" mnemonicParsing="false" onAction="#selecionarAvatarBixa" opacity="0.0" prefHeight="275.0" prefWidth="216.0">
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <Button contentDisplay="CENTER" layoutX="289.0" layoutY="23.0" mnemonicParsing="false" onAction="#botaoVoltarClicado" prefHeight="89.0" prefWidth="185.0" scaleX="0.6" scaleY="0.6" styleClass="botao-estilizado-pequeno" text="VOLTAR" textFill="#592828">
         <graphic>
            <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" styleClass="botao-estilizado">
               <image>
                  <Image url="@../imagens/BOTAO.png" />
               </image>
            </ImageView>
         </graphic>
         <font>
            <Font name="Verdana Bold" size="15.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
   </children>
</Pane>
