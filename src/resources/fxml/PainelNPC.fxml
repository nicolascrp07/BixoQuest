<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<Pane fx:id="painelRaiz" prefHeight="200.0" prefWidth="400.0" stylesheets="@../css/geral.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.view.controller.PainelNPCController">
   <children>
      <ImageView fitHeight="200.0" fitWidth="400.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../imagens/PAINELNPC.jpeg" />
         </image>
      </ImageView>
      <Button contentDisplay="CENTER" layoutX="-17.0" layoutY="88.0" mnemonicParsing="false" onAction="#btnAceitarQuestClicado" scaleX="0.5" scaleY="0.5" styleClass="botao-estilizado-pequeno" text="ACEITAR QUEST" textFill="#4b1212">
         <graphic>
            <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../imagens/BOTAO.png" />
               </image>
            </ImageView>
         </graphic>
         <font>
            <Font name="Verdana Bold" size="16.0" />
         </font>
      </Button>
      <Label fx:id="labelNome" alignment="CENTER" layoutX="43.0" layoutY="14.0" prefHeight="23.0" prefWidth="315.0" style="-fx-font-size: 18px;" styleClass="texto-retro, texto-escuro" text="Nome">
         <font>
            <Font size="10.0" />
         </font></Label>
      <Label fx:id="labelDialogo" alignment="TOP_LEFT" layoutX="28.0" layoutY="53.0" prefHeight="90.0" prefWidth="342.0" style="-fx-font-size: 14px;" styleClass="texto-retro, texto-escuro" text="Dialogo" textAlignment="JUSTIFY" wrapText="true" />
      <Button contentDisplay="CENTER" layoutX="176.0" layoutY="88.0" mnemonicParsing="false" onAction="#btnInteragirClicado" scaleX="0.5" scaleY="0.5" styleClass="botao-estilizado-pequeno" text="INTERAGIR" textFill="#4b1212">
         <graphic>
            <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../imagens/BOTAO.png" />
               </image>
            </ImageView>
         </graphic>
         <font>
            <Font name="Verdana Bold" size="16.0" />
         </font>
      </Button>
   </children>
</Pane>
